{
  "name": "kapital-bank-sdk",
  "version": "1.4.0",
  "description": "TypeScript SDK for Kapital Bank payment services",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "test:run": "vitest run",
    "dev": "tsup --watch",
    "example": "tsx examples/create-order.ts",
    "get-order": "tsx examples/get-order.ts",
    "reverse": "tsx examples/reverse.ts",
    "set-token": "tsx examples/set-source-token.ts",
    "recurring": "tsx examples/recurring-payment.ts",
    "set-dst-token": "tsx examples/set-destination-token.ts",
    "transfer": "tsx examples/transfer-to-card.ts",
    "preauthorize": "tsx examples/preauthorize.ts",
    "clear": "tsx examples/clear.ts",
    "error-test": "tsx examples/error-handling.ts",
    "watch-order": "tsx examples/watch-order.ts",
    "wait-for-payment": "tsx examples/wait-for-payment.ts",
    "hpp-payment": "tsx examples/hpp-payment.ts",
    "hpp-wait": "tsx examples/hpp-wait-for-payment.ts",
    "from-env": "tsx examples/from-env.ts",
    "hosted-payment": "tsx examples/create-hosted-payment.ts",
    "payment-events": "tsx examples/payment-events.ts",
    "restore-order": "tsx examples/restore-order.ts",
    "google-pay-order": "tsx examples/google-pay-order.ts",
    "google-pay-native": "tsx examples/google-pay-native.ts",
    "google-pay-full-flow": "tsx examples/google-pay-full-flow.ts",
    "webhook": "tsx examples/webhook-handler.ts",
    "telegram": "tsx examples/telegram-notifications.ts",
    "discord": "tsx examples/discord-notifications.ts",
    "retry": "tsx examples/retry-system.ts",
    "health": "tsx examples/health-check.ts",
    "monitoring": "tsx examples/monitoring.ts",
    "test-new-features": "tsx examples/test-new-features.ts",
    "test-security-fixes": "tsx examples/test-security-fixes.ts"
  },
  "keywords": [
  "kapital-bank",
  "kapitalbank",
  "birbank",
  "azerbaijan",
  "payment-gateway",
  "payment",
  "ecommerce",
  "3ds",
  "3d-secure",
  "typescript",
  "nodejs",
  "banking",
  "google-pay"
  ],
  "author": "Umud Quliyev",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "dotenv": "^17.4.2",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.2",
    "vitest": "^4.1.8"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Umud-Quliyev/kapital-bank-sdk.git"
  },
  "homepage": "https://github.com/Umud-Quliyev/kapital-bank-sdk",
  "bugs": {
    "url": "https://github.com/Umud-Quliyev/kapital-bank-sdk/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
