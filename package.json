{
  "name": "kapital-bank-sdk",
  "version": "0.10.0",
  "description": "TypeScript SDK for Kapital Bank payment services",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "test:run": "vitest run",
    "dev": "tsup --watch",
    "example": "tsx examples/create-order.ts",
    "get-order": "tsx examples/get-order.ts",
    "reverse": "tsx examples/reverse.ts",
    "set-token": "tsx examples/set-source-token.ts",
    "recurring": "tsx examples/recurring-payment.ts",
    "set-dst-token": "tsx examples/set-destination-token.ts",
    "transfer": "tsx examples/transfer-to-card.ts",
    "preauthorize": "tsx examples/preauthorize.ts",
    "clear": "tsx examples/clear.ts",
    "error-test": "tsx examples/error-handling.ts"
  },
  "keywords": [
    "kapital-bank",
    "payment",
    "sdk",
    "typescript"
  ],
  "author": "Umud Quliyev",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.2",
    "vitest": "^4.1.8"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Umud-Quliyev/kapital-bank-sdk.git"
  },
  "homepage": "https://github.com/Umud-Quliyev/kapital-bank-sdk",
  "bugs": {
    "url": "https://github.com/Umud-Quliyev/kapital-bank-sdk/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
