# Kapital Bank SDK — copy to .env and adjust values
# cp .env.example .env   (Linux/macOS)
# copy .env.example .env (Windows)

# Required
KAPITALBANK_USERNAME=TerminalSys/kapital
KAPITALBANK_PASSWORD=kapital123

# test | production
KAPITALBANK_MODE=test

# Optional defaults (applied to createOrder / createHostedPayment / Google Pay)
KAPITALBANK_ORDER_TYPE=Order_SMS
KAPITALBANK_GOOGLE_PAY_ORDER_TYPE=GSMS
KAPITALBANK_CURRENCY=AZN
KAPITALBANK_LANGUAGE=az
KAPITALBANK_REDIRECT_URL=https://your-site.com/callback

# Optional
# KAPITALBANK_TIMEOUT=30000
# KAPITALBANK_LOG_ENABLED=true

# Google Pay native example only — token JSON from Google Pay API (frontend)
# GOOGLE_PAY_TOKEN_JSON={"signature":"..."}

# Webhook Configuration
# KAPITALBANK_WEBHOOK_SECRET=your-webhook-secret
# KAPITALBANK_WEBHOOK_PATH=/webhook
# KAPITALBANK_WEBHOOK_ALLOWED_IPS=195.20.100.1,195.20.100.2

# Telegram Notifications
# KAPITALBANK_TELEGRAM_BOT_TOKEN=your-bot-token
# KAPITALBANK_TELEGRAM_CHAT_ID=your-chat-id
# KAPITALBANK_TELEGRAM_PARSE_MODE=Markdown
# KAPITALBANK_TELEGRAM_DISABLE_NOTIFICATION=false
# KAPITALBANK_TELEGRAM_MESSAGE_PAID=Payment {orderId} for {amount} {currency} has been paid!
# KAPITALBANK_TELEGRAM_MESSAGE_DECLINED=Payment {orderId} for {amount} {currency} was declined.
# KAPITALBANK_TELEGRAM_MESSAGE_EXPIRED=Payment {orderId} for {amount} {currency} has expired.
# KAPITALBANK_TELEGRAM_MESSAGE_REFUNDED=Payment {orderId} for {amount} {currency} has been refunded.
# KAPITALBANK_TELEGRAM_MESSAGE_REVERSED=Payment {orderId} for {amount} {currency} has been reversed.
# KAPITALBANK_TELEGRAM_ENABLE_PAID=true
# KAPITALBANK_TELEGRAM_ENABLE_DECLINED=true
# KAPITALBANK_TELEGRAM_ENABLE_EXPIRED=true
# KAPITALBANK_TELEGRAM_ENABLE_REFUNDED=true
# KAPITALBANK_TELEGRAM_ENABLE_REVERSED=true

# Discord Notifications
# KAPITALBANK_DISCORD_WEBHOOK_URL=your-webhook-url
# KAPITALBANK_DISCORD_USERNAME=Kapital Bank Bot
# KAPITALBANK_DISCORD_AVATAR_URL=https://example.com/avatar.png
# KAPITALBANK_DISCORD_MESSAGE_PAID=Payment {orderId} for {amount} {currency} has been paid!
# KAPITALBANK_DISCORD_MESSAGE_DECLINED=Payment {orderId} for {amount} {currency} was declined.
# KAPITALBANK_DISCORD_MESSAGE_EXPIRED=Payment {orderId} for {amount} {currency} has expired.
# KAPITALBANK_DISCORD_MESSAGE_REFUNDED=Payment {orderId} for {amount} {currency} has been refunded.
# KAPITALBANK_DISCORD_MESSAGE_REVERSED=Payment {orderId} for {amount} {currency} has been reversed.
# KAPITALBANK_DISCORD_ENABLE_PAID=true
# KAPITALBANK_DISCORD_ENABLE_DECLINED=true
# KAPITALBANK_DISCORD_ENABLE_EXPIRED=true
# KAPITALBANK_DISCORD_ENABLE_REFUNDED=true
# KAPITALBANK_DISCORD_ENABLE_REVERSED=true

# Retry Configuration
# KAPITALBANK_RETRY_MAX_ATTEMPTS=3
# KAPITALBANK_RETRY_INITIAL_DELAY=1000
# KAPITALBANK_RETRY_MAX_DELAY=30000
# KAPITALBANK_RETRY_BACKOFF_MULTIPLIER=2
# KAPITALBANK_RETRY_RETRYABLE_ERRORS=ECONNRESET,ETIMEDOUT,ECONNREFUSED
